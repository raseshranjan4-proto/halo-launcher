<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="108dp" android:height="108dp" />
            <corners android:radius="24dp" />
            <gradient android:angle="315" android:startColor="#FF0E0F1A" android:endColor="#FF2B2F55" />
        </shape>
    </item>
    <item android:left="30dp" android:right="30dp" android:top="30dp" android:bottom="30dp">
        <shape android:shape="oval">
            <stroke android:width="6dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
